# Uniform entry points (generated by sdlc for profiles: node-ts-pnpm).
# Edit freely: sdlc never overwrites an existing Makefile.
.PHONY: dev test lint build

dev:
	pnpm run dev

test:
	pnpm run --if-present test

lint:
	pnpm exec prettier --check . && pnpm exec eslint . && pnpm exec tsc -b

build:
	pnpm run --if-present build
