{
	"compilerOptions": {
		"target": "es2024",
		"lib": ["ES2024", "DOM"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.model.tsbuildinfo"
	},
	"include": ["src"]
}
